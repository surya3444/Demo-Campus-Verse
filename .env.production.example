# ===========================================
# Production Environment Variables
# ===========================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control

# Application
NODE_ENV=production
PORT=3001
APP_URL=https://test.campusverse.app
API_URL=https://api.campusverse.app

# MongoDB Atlas
# Get your connection string from MongoDB Atlas dashboard and add database name
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_verse?retryWrites=true&w=majority&appName=<appName>

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379

# JWT Secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=CHANGE_ME_generate_random_string_minimum_32_characters
JWT_REFRESH_SECRET=CHANGE_ME_generate_different_random_string_minimum_32_characters
JWT_ACCESS_EXPIRY=15m
# Sliding inactivity window: sessions end only after this much continuous inactivity
JWT_REFRESH_EXPIRY=90d

# AWS S3 (for file uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=campusverse-files-prod

# SMS Gateway - MSG91
SMS_API_KEY=your-msg91-api-key
SMS_SENDER_ID=CAMPUS
SMS_DLT_TE_ID=your-dlt-template-id

# Email - SMTP (use a transactional email service in production)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@campusverse.app

# Encryption Key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=generate_64_char_hex_string_for_encryption

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Logging
LOG_LEVEL=info
