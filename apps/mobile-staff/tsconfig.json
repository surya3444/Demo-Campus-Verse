{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@campus-verse/shared": ["../../packages/shared/src"],
      "@campus-verse/shared/*": ["../../packages/shared/src/*"],
      "@campus-verse/mobile-shared": ["../../packages/mobile-shared/src"],
      "@campus-verse/mobile-shared/*": ["../../packages/mobile-shared/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
